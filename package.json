{
  "name": "incident-os",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered SRE incident investigation and remediation platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm --filter @incident-os/server dev\" \"pnpm --filter @incident-os/web dev\"",
    "dev:server": "pnpm --filter @incident-os/server dev",
    "dev:web": "pnpm --filter @incident-os/web dev",
    "generate:demo-data": "tsx scripts/generate-demo-data.ts && tsx scripts/generate-attack-data.ts",
    "investigate": "pnpm --filter @incident-os/server investigate",
    "typecheck": "tsc --noEmit -p server/tsconfig.json",
    "demo:promote": "tsx scripts/promote-recording.ts",
    "verify": "tsx scripts/verify-setup.ts",
    "db:up": "docker compose up -d --wait",
    "db:check": "pnpm --filter @incident-os/server db:check",
    "db:setup": "pnpm --filter @incident-os/server db:setup",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:psql": "docker compose exec postgres psql -U incidentos -d incidentos",
    "test:incidents": "vitest run server/src/incidents/*.test.ts",
    "webhook:send": "tsx scripts/send-incident-webhook.ts",
    "seed:incidents": "tsx scripts/seed-incidents.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.18.0"
}
