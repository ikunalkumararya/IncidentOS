# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
PORT=4000

# Wall-clock cap for one investigation. If the agent is still running when this
# elapses, the server cuts over to the recorded stream so the demo never stalls.
INVESTIGATION_TIMEOUT_MS=90000

# Set to 1 to always replay the recorded stream instead of calling the API.
DEMO_MODE=0

# Postgres for run history. Matches docker-compose.yml; start it with
# `pnpm db:up`. Persistence is an enhancement — with the database down the
# demo still runs and streams, runs just are not saved.
DATABASE_URL=postgres://incidentos:incidentos@localhost:5432/incidentos

# Set to 0 to skip connecting to Postgres entirely.
PERSIST=1
