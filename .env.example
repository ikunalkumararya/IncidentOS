# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
PORT=4000

# Wall-clock cap for one investigation. If the agent is still running when this
# elapses, the server cuts over to the recorded stream so the demo never stalls.
INVESTIGATION_TIMEOUT_MS=90000

# Wall-clock cap for one attack investigation. Longer than the incident's
# because the fix phase runs a patch, a type-check, the test suite and two
# attack-replay simulations rather than one memory measurement. Attack runs
# have no recorded fallback, so exceeding this ends the run with a fatal error.
ATTACK_TIMEOUT_MS=180000

# Set to 1 to always replay the recorded stream instead of calling the API.
DEMO_MODE=0

# Postgres for run history. Matches docker-compose.yml; start it with
# `pnpm db:up`. Persistence is an enhancement — with the database down the
# demo still runs and streams, runs just are not saved.
DATABASE_URL=postgres://incidentos:incidentos@localhost:5432/incidentos
# Neon: replace the URL above with the pooled connection string from Connect.
# Keep its SSL parameters. Example (placeholders only):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_CONNECT_TIMEOUT_MS=15000

# Set to 0 to skip connecting to Postgres entirely.
PERSIST=1

# --- Authentication -------------------------------------------------------
# Signing key for session JWTs. Unset falls back to a public default and the
# server warns at boot — fine locally, never anywhere reachable.
JWT_SECRET=
SESSION_TTL_SECONDS=43200

# Origin allowed to send credentialed requests (the dashboard).
WEB_ORIGIN=http://localhost:3000

# Seeded on first boot so a fresh database is usable without registering.
# Set to 0 for a shared team database; each teammate can use /signup.
SEED_DEMO_USER=1
DEMO_USER_EMAIL=demo@incidentos.dev
DEMO_USER_PASSWORD=incident123
DEMO_USER_NAME=Demo Responder
